# Copy this file to .env and fill in real values. Never commit .env.
# All VITE_* variables are inlined into the client-side JS bundle at build
# time by Vite — none of these are secret, they're just environment-specific.

# Base URL of the FastAPI server (see Server/.env.example). Point this at
# http://localhost:8000 for local development.
VITE_SERVER_URL=http://localhost:8000

# Google OAuth client ID used by @react-oauth/google for the Sheets/Calendar
# "Connect" flows. Must match a client ID from the same Google Cloud project
# as the server's GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET, with localhost added
# under Authorized JavaScript origins for local dev.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Stripe Payment Link URLs (Stripe Dashboard > Payment Links), one per
# subscription tier offered on the pricing/onboarding pages.
VITE_STARTER_PAYMENT_LINK=https://buy.stripe.com/xxxxxxxx
VITE_GROWTH_PAYMENT_LINK=https://buy.stripe.com/xxxxxxxx
VITE_PRO_PAYMENT_LINK=https://buy.stripe.com/xxxxxxxx
VITE_EARLY_ACCESS_PAYMENT_LINK=https://buy.stripe.com/xxxxxxxx
# Referenced in OnboardingPage.tsx (VITE_BASIC_PAYMENT_LINK) but not present
# in the current .env — add it if/when a "basic" tier payment link exists.
VITE_BASIC_PAYMENT_LINK=https://buy.stripe.com/xxxxxxxx
